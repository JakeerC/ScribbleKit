{
  "name": "scribblekit",
  "version": "1.1.1",
  "type": "module",
  "description": "190+ hand-drawn vector scribbles, animated highlights, and interactive React SVG component library",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.d.ts",
    "dist/style.css",
    "dist/components/**/*.d.ts",
    "dist/lib/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build:app": "vite build && echo '✅ Showcase Web App built successfully'",
    "build:types": "tsc -p tsconfig.lib.json && echo '✅ TypeScript declarations generated in dist/'",
    "build:lib": "npm run build:types && vite build --config vite.config.lib.ts && echo '✅ Library bundle created (ESM, CJS, CSS)'",
    "build": "npm run build:app && npm run build:lib && echo '🎉 Complete build finished successfully!'",
    "test": "npm run build:lib && node scripts/test-consumer.mjs && echo '✅ All consumer integration tests passed!'",
    "verify:release": "npm run build:lib && npm test && npm run build && npm pack --dry-run && echo '\n🎉 [VERIFIED] All checks passed cleanly! Run `npm publish` to deploy.'",
    "prepack": "npm run build:lib",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "scribbles",
    "svg",
    "hand-drawn",
    "doodles",
    "design-assets",
    "figma",
    "vector",
    "arrows",
    "underlines",
    "badges",
    "react",
    "react-components",
    "ui-components",
    "scribblekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakeerC/ScribbleKit.git"
  },
  "homepage": "https://scribblekit.vercel.app",
  "bugs": {
    "url": "https://github.com/JakeerC/ScribbleKit/issues"
  },
  "author": "ScribbleKit",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.5"
  }
}
